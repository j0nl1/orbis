+// Fullscreen capture forwards physical input before AppKit consumes Mac shortcuts.
+- (void)sendCapturedEvent:(CGEventRef)event windowPoint:(NSPoint)point
+{
+	if (!self.is_connected || !instance || !instance->context || !event) return;
+	rdpInput *input = instance->context->input;
+	CGEventType type = CGEventGetType(event);
+	DWORD flags = (DWORD)(CGEventGetFlags(event) & NSEventModifierFlagDeviceIndependentFlagsMask);
+	updateFlagStates(input, flags, kbdModFlags);
+	kbdModFlags = flags;
+	if (type == kCGEventFlagsChanged) return;
+	if (type == kCGEventKeyDown || type == kCGEventKeyUp)
+	{
+		NSUInteger code = (NSUInteger)CGEventGetIntegerValueField(event, kCGKeyboardEventKeycode);
+		if (code >= sizeof(capturedKeyScancodes) / sizeof(capturedKeyScancodes[0])) return;
+		DWORD scancode;
+		if (type == kCGEventKeyUp)
+		{
+			if (!capturedKeyScancodes[code]) return;
+			scancode = capturedKeyScancodes[code] - 1;
+			capturedKeyScancodes[code] = 0;
+		}
+		else
+		{
+			DWORD keyCode = fixKeyCode((DWORD)code, 0, mfc->appleKeyboardType);
+			DWORD vkcode = GetVirtualKeyCodeFromKeycode(keyCode, WINPR_KEYCODE_TYPE_APPLE);
+			scancode = GetVirtualScanCodeFromVirtualKeyCode(vkcode, 4);
+			if (!(scancode & 0xFF)) return;
+			capturedKeyScancodes[code] = scancode + 1;
+		}
+		freerdp_input_send_keyboard_event(input, (scancode & KBDEXT) |
+		    (type == kCGEventKeyDown ? KBD_FLAGS_DOWN : KBD_FLAGS_RELEASE), scancode & 0xFF);
+		return;
+	}
+	if (type == kCGEventScrollWheel)
+	{
+		[self scrollWheel:[NSEvent eventWithCGEvent:event]];
+		return;
+	}
+	BOOL down = type == kCGEventLeftMouseDown || type == kCGEventRightMouseDown || type == kCGEventOtherMouseDown;
+	BOOL up = type == kCGEventLeftMouseUp || type == kCGEventRightMouseUp || type == kCGEventOtherMouseUp;
+	NSInteger button = (NSInteger)CGEventGetIntegerValueField(event, kCGMouseEventButtonNumber);
+	if ((down || up) && (button < 0 || button > 4)) return;
+	NSEvent *pointer = [NSEvent mouseEventWithType:(NSEventType)type location:point
+	    modifierFlags:flags timestamp:(NSTimeInterval)CGEventGetTimestamp(event) / 1e9
+	    windowNumber:self.window.windowNumber context:nil eventNumber:0 clickCount:1 pressure:0];
+	capturedPointerPoint = point;
+	if (down) capturedButtons |= 1UL << button;
+	if (up) capturedButtons &= ~(1UL << button);
+	[self sendDisplayPointer:pointer button:(down || up) ? button : -1 down:down];
+}
