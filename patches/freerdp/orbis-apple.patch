+	for (NSUInteger code = 0; code < sizeof(capturedKeyScancodes) / sizeof(capturedKeyScancodes[0]); code++)
+	{
+		if (!capturedKeyScancodes[code]) continue;
+		DWORD scancode = capturedKeyScancodes[code] - 1;
+		if (input) freerdp_input_send_keyboard_event(input, (scancode & KBDEXT) | KBD_FLAGS_RELEASE, scancode & 0xFF);
+		capturedKeyScancodes[code] = 0;
+		locallyHandledKeyDown[code] = TRUE;
+	}
+	if (input)
+	{
+		NSEvent *pointer = [NSEvent mouseEventWithType:NSEventTypeLeftMouseUp location:capturedPointerPoint
+		    modifierFlags:0 timestamp:0 windowNumber:self.window.windowNumber context:nil
+		    eventNumber:0 clickCount:0 pressure:0];
+		for (NSUInteger button = 0; button <= 4; button++)
+			if (capturedButtons & (1UL << button)) [self sendDisplayPointer:pointer button:(NSInteger)button down:NO];
+		releaseFlagStates(input, kbdModFlags);
+	}
+	capturedButtons = 0;
+	kbdModFlags = 0;
