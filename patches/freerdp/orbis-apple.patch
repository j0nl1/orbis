+- (BOOL)sendMappedCommandShortcut:(NSEvent *)event
+{
+	DWORD modFlags = [event modifierFlags] & NSEventModifierFlagDeviceIndependentFlagsMask;
+	const MacCommandShortcutAction action = mac_command_shortcut_action(event);
+	if (!mapsCommandShortcutsToControl || !(modFlags & NSEventModifierFlagCommand) ||
+	    (action == MacCommandShortcutNone))
+		return FALSE;
+	commandTapConsumed = TRUE;
+
+	const unsigned short keyCode = [event keyCode];
+	const NSTimeInterval now = [NSDate timeIntervalSinceReferenceDate];
+	// Remote-control hops can inject the same Command shortcut more than once,
+	// with isARepeat still false and without a matching key-up. Coalesce only
+	// the immediate duplicate; a deliberate later shortcut remains actionable.
+	if ((lastMappedShortcutKeyCode == keyCode) &&
+	    ((now - lastMappedShortcutTimestamp) < 0.15))
+	{
+		return TRUE;
+	}
+	lastMappedShortcutKeyCode = keyCode;
+	lastMappedShortcutTimestamp = now;
+
+	NSString *characters = [event charactersIgnoringModifiers];
+	DWORD correctedKeyCode = keyCode;
+	if ([characters length] > 0)
+	{
+		const unichar keyChar = [characters characterAtIndex:0];
+		correctedKeyCode = fixKeyCode(correctedKeyCode, keyChar, mfc->appleKeyboardType);
+	}
+	DWORD vkcode = GetVirtualKeyCodeFromKeycode(correctedKeyCode, WINPR_KEYCODE_TYPE_APPLE);
+	DWORD scancode = GetVirtualScanCodeFromVirtualKeyCode(vkcode, 4);
+	DWORD keyFlags = (scancode & KBDEXT) ? KBDEXT : 0;
+	scancode &= 0xFF;
+
+	rdpInput *input = instance->context->input;
+	// Treat Mac-style shortcuts as complete chords. Some nested macOS remote
+	// clients deliver Command+A/C/V as key-down-only events; waiting for their
+	// absent key-up leaves the remote key repeating indefinitely.
+	releaseFlagStates(input, kbdModFlags);
+	kbdModFlags = 0;
+	DWORD chordFlags = modFlags & ~NSEventModifierFlagCommand;
+	switch (action)
+	{
+		case MacCommandShortcutControl:
+			chordFlags |= NSEventModifierFlagControl;
+			break;
+		case MacCommandShortcutBackspace:
+			/* Keep Backspace unchanged, but send it as a complete atomic chord. */
+			break;
+		case MacCommandShortcutNone:
+			return FALSE;
+	}
+	updateFlagStates(input, chordFlags, 0);
+	kbdModFlags = chordFlags;
+	freerdp_input_send_keyboard_event(input, keyFlags | KBD_FLAGS_DOWN, scancode);
+	freerdp_input_send_keyboard_event(input, keyFlags | KBD_FLAGS_RELEASE, scancode);
+	releaseFlagStates(input, kbdModFlags);
+	kbdModFlags = 0;
+	return TRUE;
+}
