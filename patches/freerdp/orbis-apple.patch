+- (BOOL)sendMappedCommandShortcut:(NSEvent *)event
+{
+	DWORD modFlags = [event modifierFlags] & NSEventModifierFlagDeviceIndependentFlagsMask;
+	const MacCommandShortcutAction action = mac_command_shortcut_action(event);
+	if (!mapsCommandShortcutsToControl || !(modFlags & NSEventModifierFlagCommand) ||
+	    (action == MacCommandShortcutNone))
+		return FALSE;
+	commandTapConsumed = TRUE;
+
+	const unsigned short keyCode = [event keyCode];
+	if (keyCode < sizeof(locallyHandledKeyDown) / sizeof(locallyHandledKeyDown[0]))
+		locallyHandledKeyDown[keyCode] = TRUE;
+	const NSTimeInterval now = [NSDate timeIntervalSinceReferenceDate];
+	// Remote-control hops can inject the same Command shortcut more than once,
+	// with isARepeat still false and without a matching key-up. Coalesce only
+	// the immediate duplicate; a deliberate later shortcut remains actionable.
+	if ((lastMappedShortcutKeyCode == keyCode) &&
+	    ((now - lastMappedShortcutTimestamp) < 0.15))
+	{
+		return TRUE;
+	}
+	lastMappedShortcutKeyCode = keyCode;
+	lastMappedShortcutTimestamp = now;
+
+	NSString *characters = [event charactersIgnoringModifiers];
+	DWORD correctedKeyCode = keyCode;
+	if ([characters length] > 0)
+	{
+		const unichar keyChar = [characters characterAtIndex:0];
+		correctedKeyCode = fixKeyCode(correctedKeyCode, keyChar, mfc->appleKeyboardType);
+	}
+	DWORD vkcode = GetVirtualKeyCodeFromKeycode(correctedKeyCode, WINPR_KEYCODE_TYPE_APPLE);
+	DWORD scancode = GetVirtualScanCodeFromVirtualKeyCode(vkcode, 4);
+	DWORD keyFlags = (scancode & KBDEXT) ? KBDEXT : 0;
+	scancode &= 0xFF;
+
+	rdpInput *input = instance->context->input;
+	// Treat Mac-style shortcuts as complete chords. Some nested macOS remote
+	// clients deliver Command+A/C/V as key-down-only events; waiting for their
+	// absent key-up leaves the remote key repeating indefinitely.
+	releaseFlagStates(input, kbdModFlags);
+	kbdModFlags = 0;
+	DWORD chordFlags = modFlags & ~NSEventModifierFlagCommand;
+	switch (action)
+	{
+		case MacCommandShortcutControl:
+			chordFlags |= NSEventModifierFlagControl;
+			break;
+		case MacCommandShortcutBackspace:
+			/* Keep Backspace unchanged, but send it as a complete atomic chord. */
+			break;
+		case MacCommandShortcutNone:
+			return FALSE;
+	}
+	updateFlagStates(input, chordFlags, 0);
+	kbdModFlags = chordFlags;
+	freerdp_input_send_keyboard_event(input, keyFlags | KBD_FLAGS_DOWN, scancode);
+	freerdp_input_send_keyboard_event(input, keyFlags | KBD_FLAGS_RELEASE, scancode);
+	releaseFlagStates(input, kbdModFlags);
+	kbdModFlags = 0;
+	return TRUE;
+}
+
+- (BOOL)sendMappedOptionBackspace:(NSEvent *)event
+{
+	DWORD flags = [event modifierFlags] & NSEventModifierFlagDeviceIndependentFlagsMask;
+	if (!mapsCommandShortcutsToControl || [event keyCode] != APPLE_VK_Delete ||
+	    !(flags & NSEventModifierFlagOption) ||
+	    (flags & (NSEventModifierFlagCommand | NSEventModifierFlagControl)))
+		return FALSE;
+
+	rdpInput *input = instance->context->input;
+	DWORD lockFlags = flags & (NSEventModifierFlagCapsLock | NSEventModifierFlagNumericPad);
+	DWORD chordFlags = (flags & ~NSEventModifierFlagOption) | NSEventModifierFlagControl;
+	// Send each word deletion as a complete chord, including key repeats.
+	// Release Alt first if an earlier pointer gesture or shortcut pressed it.
+	updateFlagStates(input, lockFlags, kbdModFlags);
+	updateFlagStates(input, chordFlags, lockFlags);
+	freerdp_input_send_keyboard_event(input, KBD_FLAGS_DOWN, RDP_SCANCODE_BACKSPACE);
+	freerdp_input_send_keyboard_event(input, KBD_FLAGS_RELEASE, RDP_SCANCODE_BACKSPACE);
+	updateFlagStates(input, lockFlags, chordFlags);
+	kbdModFlags = lockFlags;
+	locallyHandledKeyDown[[event keyCode]] = TRUE;
+	return TRUE;
+}
+
+- (BOOL)sendOptionText:(NSEvent *)event
+{
+	NSEventModifierFlags flags = [event modifierFlags];
+	NSString *text = [event characters];
+	unsigned short code = [event keyCode];
+	if (!mapsCommandShortcutsToControl || !(flags & NSEventModifierFlagOption) ||
+	    (flags & (NSEventModifierFlagCommand | NSEventModifierFlagControl)) ||
+	    code >= sizeof(locallyHandledKeyDown) / sizeof(locallyHandledKeyDown[0]) || [text length] == 0)
+		return FALSE;
+	for (NSUInteger index = 0; index < [text length]; index++)
+	{
+		unichar character = [text characterAtIndex:index];
+		if ([[NSCharacterSet controlCharacterSet] characterIsMember:character] ||
+		    (character >= 0xF700 && character <= 0xF8FF))
+			return FALSE;
+	}
+
+	rdpInput *input = instance->context->input;
+	// Preserve lock toggles, but release transient modifiers so the server inserts
+	// the character macOS produced rather than invoking an Alt/Shift shortcut.
+	DWORD lockFlags = kbdModFlags & (NSEventModifierFlagCapsLock | NSEventModifierFlagNumericPad);
+	updateFlagStates(input, lockFlags, kbdModFlags);
+	kbdModFlags = lockFlags;
+	locallyHandledKeyDown[code] = TRUE;
+	for (NSUInteger index = 0; index < [text length]; index++)
+	{
+		unichar character = [text characterAtIndex:index];
+		freerdp_input_send_unicode_keyboard_event(input, KBD_FLAGS_DOWN, character);
+		freerdp_input_send_unicode_keyboard_event(input, KBD_FLAGS_RELEASE, character);
+	}
+	return TRUE;
+}
