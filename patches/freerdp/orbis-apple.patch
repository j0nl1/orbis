+}
+
+- (void)releaseCommandKeys
+{
+	rdpInput *input = (is_connected && instance && instance->context) ? instance->context->input : NULL;
+	for (NSUInteger code = 0; code < sizeof(commandKeyScancodes) / sizeof(commandKeyScancodes[0]); code++)
+	{
+		if (!commandKeyScancodes[code])
+			continue;
+		DWORD scancode = commandKeyScancodes[code] - 1;
+		if (input)
+			freerdp_input_send_keyboard_event(input, (scancode & KBDEXT) | KBD_FLAGS_RELEASE, scancode & 0xFF);
+		commandKeyScancodes[code] = 0;
+		locallyHandledKeyDown[code] = TRUE;
+	}
+}
+
+- (void)setCommandKeyDown:(BOOL)commandIsDown
+{
+	if (!is_connected || !mapsCommandShortcutsToControl)
+		return;
+	if (!commandIsDown)
+		[self releaseCommandKeys];
+	if (commandIsDown && !commandTapPending)
+	{
+		commandTapPending = TRUE;
+		commandTapConsumed = FALSE;
+	}
+	else if (!commandIsDown && commandTapPending)
+	{
+		if (!commandTapConsumed)
+		{
+			DWORD scancode = RDP_SCANCODE_LWIN;
+			DWORD keyFlags = scancode & KBDEXT;
+			scancode &= 0xFF;
+			freerdp_input_send_keyboard_event(instance->context->input,
+			                                  keyFlags | KBD_FLAGS_DOWN, scancode);
+			freerdp_input_send_keyboard_event(instance->context->input,
+			                                  keyFlags | KBD_FLAGS_RELEASE, scancode);
+		}
+		commandTapPending = FALSE;
+		commandTapConsumed = FALSE;
+	}
+}
+
+- (void)cancelPendingCommandTap
+{
+	[self releaseCommandKeys];
+	commandTapPending = FALSE;
+	commandTapConsumed = FALSE;
+}
