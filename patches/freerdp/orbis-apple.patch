+	BOOL closeActivities = action == OrbisIPadWorkspaceCloseActivities;
+	BOOL previous = action == OrbisIPadWorkspacePrevious;
+	BOOL screenshot = action >= OrbisIPadWorkspaceScreenshotScreen && action <= OrbisIPadWorkspaceScreenshotWindow;
+	if (!screenshot && !activities && !closeActivities && !previous && action != OrbisIPadWorkspaceNext)
+		return;
+	RDPKeyboard *keyboard = [RDPKeyboard getSharedRDPKeyboard];
+	NSMutableArray *controls = [NSMutableArray arrayWithArray:_remoteControlKeys.allObjects];
+	if ((_commandControlDown || keyboard.ctrlPressed) && ![controls containsObject:@(VK_LCONTROL)])
+		[controls addObject:@(VK_LCONTROL)];
+	for (NSNumber *control in controls) [keyboard sendVirtualKey:control.intValue up:YES];
+	BOOL restoreWin = keyboard.winPressed;
+	if (restoreWin) [keyboard sendVirtualKey:(VK_LWIN | KBDEXT) up:YES];
+	[[OrbisDiagnostics sharedDiagnostics] recordEvent:@"workspace.action" values:@{ @"action" : @(action) }];
+	// Local modifiers select the action without altering the remote chord.
+	BOOL restoreAlt = _remoteOptionDown || keyboard.altPressed;
+	NSArray *shifts = [_remoteShiftKeys allObjects];
+	if (restoreAlt) [keyboard sendVirtualKey:VK_LMENU up:YES];
+	for (NSNumber *shift in shifts) [keyboard sendVirtualKey:shift.intValue up:YES];
+	if (keyboard.shiftPressed && ![shifts containsObject:@(VK_LSHIFT)])
+		[keyboard sendVirtualKey:VK_LSHIFT up:YES];
+	if (screenshot)
+	{
+		int modifier = action == OrbisIPadWorkspaceScreenshotScreen ? VK_LSHIFT :
+		    (action == OrbisIPadWorkspaceScreenshotWindow ? VK_LMENU : 0);
+		if (modifier) [keyboard sendVirtualKey:modifier up:NO];
+		[keyboard sendVirtualKey:(VK_SNAPSHOT | KBDEXT) up:NO];
+		[keyboard sendVirtualKey:(VK_SNAPSHOT | KBDEXT) up:YES];
+		if (modifier) [keyboard sendVirtualKey:modifier up:YES];
+	}
+	else if (closeActivities)
+	{
+		[keyboard sendVirtualKey:VK_ESCAPE up:NO];
+		[keyboard sendVirtualKey:VK_ESCAPE up:YES];
+	}
+	else
+	{
+		[keyboard sendVirtualKey:(VK_LWIN | KBDEXT) up:NO];
+		if (!activities)
+		{
+			int key = (previous ? VK_PRIOR : VK_NEXT) | KBDEXT;
+			[keyboard sendVirtualKey:key up:NO];
+			[keyboard sendVirtualKey:key up:YES];
+		}
+		[keyboard sendVirtualKey:(VK_LWIN | KBDEXT) up:YES];
+	}
+	if (keyboard.shiftPressed && ![shifts containsObject:@(VK_LSHIFT)])
+		[keyboard sendVirtualKey:VK_LSHIFT up:NO];
+	for (NSNumber *shift in shifts) [keyboard sendVirtualKey:shift.intValue up:NO];
+	if (restoreAlt) [keyboard sendVirtualKey:VK_LMENU up:NO];
+	for (NSNumber *control in controls) [keyboard sendVirtualKey:control.intValue up:NO];
+	if (restoreWin) [keyboard sendVirtualKey:(VK_LWIN | KBDEXT) up:NO];
+}
+
+- (void)sendDeleteShortcutToLineStart:(BOOL)lineStart
+{
+	RDPKeyboard *keyboard = [RDPKeyboard getSharedRDPKeyboard];
+	BOOL restoreAlt = _remoteOptionDown || keyboard.altPressed;
+	BOOL restoreControl = _commandControlDown || keyboard.ctrlPressed;
+	NSMutableArray *shifts = [NSMutableArray arrayWithArray:[_remoteShiftKeys allObjects]];
+	if (keyboard.shiftPressed && ![shifts containsObject:@(VK_LSHIFT)]) [shifts addObject:@(VK_LSHIFT)];
+	// Shift selects the local shortcut; it must not make remote Delete permanent.
+	if (restoreAlt) [keyboard sendVirtualKey:VK_LMENU up:YES];
+	if (restoreControl) [keyboard sendVirtualKey:VK_LCONTROL up:YES];
+	if (keyboard.winPressed) [keyboard sendVirtualKey:(VK_LWIN | KBDEXT) up:YES];
+	for (NSNumber *shift in shifts) [keyboard sendVirtualKey:shift.intValue up:YES];
+	if (lineStart)
+	{
+		[keyboard sendVirtualKey:VK_LSHIFT up:NO];
+		[keyboard sendVirtualKey:(VK_HOME | KBDEXT) up:NO];
+		[keyboard sendVirtualKey:(VK_HOME | KBDEXT) up:YES];
+		[keyboard sendVirtualKey:VK_LSHIFT up:YES];
+	}
+	int deletion = lineStart ? VK_BACK : (VK_DELETE | KBDEXT);
+	[keyboard sendVirtualKey:deletion up:NO];
+	[keyboard sendVirtualKey:deletion up:YES];
+	for (NSNumber *shift in shifts) [keyboard sendVirtualKey:shift.intValue up:NO];
+	if (keyboard.winPressed) [keyboard sendVirtualKey:(VK_LWIN | KBDEXT) up:NO];
+	if (restoreControl) [keyboard sendVirtualKey:VK_LCONTROL up:NO];
+	if (restoreAlt) [keyboard sendVirtualKey:VK_LMENU up:NO];
+}
